platform :osx, '11.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    
    # Ensure consistent macOS deployment target
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '11.0'
      
      # Fix for the specific GCC_WARN_INHIBIT_ALL_WARNINGS issue that caused -G flag problem
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'NO'
      
      # Set debug info format to avoid clang issues
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
    end
    
    # Fix individual file-level compiler flags that contain the problematic flag
    target.build_phases.each do |build_phase|
      if build_phase.respond_to?(:files)
        build_phase.files.each do |build_file|
          if build_file.settings && build_file.settings['COMPILER_FLAGS']
            compiler_flags = build_file.settings['COMPILER_FLAGS']
            if compiler_flags.is_a?(String) && compiler_flags.include?('GCC_WARN_INHIBIT_ALL_WARNINGS')
              # Remove the problematic flag
              new_flags = compiler_flags.gsub(/GCC_WARN_INHIBIT_ALL_WARNINGS/, '').strip
              build_file.settings['COMPILER_FLAGS'] = new_flags.empty? ? nil : new_flags
            end
          end
        end
      end
    end
  end
end

# Fix Xcode script phase warnings
post_integrate do |installer|
  main_project = installer.aggregate_targets[0].user_project
  pods_project = installer.pods_project
  
  [main_project, pods_project].each do |project|
    project.targets.each do |target|
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
          if (phase.input_paths || []).empty? && (phase.output_paths || []).empty?
            phase.always_out_of_date = "1"
          end
        end
      end
    end
    project.save
  end
end